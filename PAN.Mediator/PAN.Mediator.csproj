<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>

    <!-- Datos para NuGet -->
    <PackageId>PAN.Mediator</PackageId>
    <Version>2.0.0</Version>
    <Authors>Pedro Avila</Authors>
    <Description>Mediador inmutable, ligero y nativo para CQRS y Arquitectura Hexagonal en .NET. Reemplazo de MediatR con paridad de API (Send/Publish, pipeline behaviors, Unit) y estrategias de publish pluggables.</Description>
    <PackageTags>mediator;cqrs;hexagonal;pan;pipeline;behavior;notification</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PedroAvila/PanMediator</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/PedroAvila/PanMediator.git</RepositoryUrl>
    <PackageReleaseNotes>v2.0.0: source generator Roslyn con dispatch monomórfico en tiempo de compilación y fallback reflexivo; API pública migrada a ValueTask/ValueTask&lt;T&gt; (cambio breaking); optimizaciones de hot path con fast paths para 0/1 behaviors y 0/1 handlers; analyzer incluido en el paquete y auto-registro del mediador generado en AddPanMediator.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the generator before pack, but do not reference or analyze this project with it. -->
    <ProjectReference Include="..\PAN.Mediator.SourceGenerators\PAN.Mediator.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <!-- Ship the generator inside the package so consumers get it automatically. -->
    <None Include="..\PAN.Mediator.SourceGenerators\bin\$(Configuration)\netstandard2.0\PAN.Mediator.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

</Project>